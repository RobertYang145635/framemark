<?xml version="1.0" encoding="utf-8"?>
<!--
  FrameMark launcher icon, background layer.

  WP-X3 §7: the build shipped with **no** `android:icon` at all
  (`aapt2 dump badging` → `application: label='FrameMark' icon=''`), so the platform
  drew its placeholder robot on the launcher, in Recents and — on Android 12+ — on
  the launch splash. minSdk is 26, so an adaptive icon in `mipmap-anydpi-v26` is the
  only size the app needs; the layers are vectors so there is no bitmap to keep in
  sync with the brand.

  Background: the stage colour (`FmColors.stage` #2B2C2F), the same surface the app
  paints its photos on in both appearances.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#2B2C2F" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  FrameMark launcher icon, foreground layer: the app's own brand mark
  (`DeskBrandMark` in DesktopLayout.kt) — a light "window" (the photo) sitting on the
  dark stage, with the accent bar under it (the watermark line).

  Geometry is centred in the 72 dp adaptive-icon safe zone (18..90 of the 108 box).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the photo window -->
    <path
        android:pathData="M32,32h44a6,6 0 0,1 6,6v28a6,6 0 0,1 -6,6h-44a6,6 0 0,1 -6,-6v-28a6,6 0 0,1 6,-6z"
        android:fillColor="#F2F4F7" />
    <!-- inner mat: the dark band that makes it read as a print, not a white blob -->
    <path
        android:pathData="M32,32h44a6,6 0 0,1 6,6v4h-56v-4a6,6 0 0,1 6,-6z"
        android:fillColor="#DCE1E7" />
    <!-- the watermark line under the window -->
    <path
        android:pathData="M36,82h26a3,3 0 0,1 0,6h-26a3,3 0 0,1 0,-6z"
        android:fillColor="#2F75E5" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅用于「检查更新」读取 GitHub Releases 的版本信息；不访问其它地址。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      WP-X3 §7: android:allowBackup was left at the platform default (true). The app's
      private files dir holds the user's project document (project.json: photos,
      per-photo designs, watermarks), the preset library and settings/appearance.json —
      none of it encrypted, and 工程/预设 reference absolute photo paths that do not
      exist on a restored device. Auto Backup would upload all of it to the user's
      Drive and restore a half-broken project on a new phone, so backup is off.
      Existing users are unaffected on this device: nothing is deleted, and the files
      stay where they are; what stops is the copy on Google's servers (an already
      uploaded backup is kept by the platform, not by the app, and is not restored to
      a build without allowBackup). The manual escape hatches stay: 导出预设 writes a
      .json the user owns, and phone exports land in the gallery.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="FrameMark"
        android:theme="@style/Theme.FrameMark"
        android:supportsRtl="true">
        <provider
            android:name="com.framemark.native.workflow.FrameMarkFileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fm_share_paths" />
        </provider>
        <activity
            android:name="com.framemark.native.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              相册/文件管理器的「分享」入口（2026-11-21）：出现在系统分享面板里，
              用户选中后把图片直接带进编辑器。单张与多张各一条；只声明 image/*，
              其它类型不进面板。`singleTop` + `onNewIntent` 保证已在后台时复用本实例。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/fm_shortcuts" />
        </activity>
    </application>

</manifest>

{
  "name": "framemark",
  "version": "1.0.0",
  "description": "框印 FrameMark — 边框 · 水印 · 批量",
  "main": "out/main/index.js",
  "author": "FrameMark",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node ./node_modules/electron-vite/bin/electron-vite.js dev",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json && node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && node ./node_modules/electron-vite/bin/electron-vite.js build",
    "start": "node ./node_modules/electron/cli.js .",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "validate:ir": "node scripts/system-camera/validate-ir.cjs",
    "previews:stock": "node scripts/system-camera/build-previews.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "exifr": "7.1.3",
    "lucide-react": "1.61.0",
    "piexifjs": "1.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "docx": "^9.14.0",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "libpag": "^4.5.85",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}

# FrameMark baseline ignore list (W0a)
# Build outputs / installed dependencies
node_modules/
out/
release/
android/.gradle/
android/build/
android/app/build/

# Native Compose/Rust build outputs and machine-local SDK configuration
ui/.gradle/
ui/.kotlin/
ui/build/
ui/composeApp/build/
ui/composeApp/.cxx/
ui/local.properties
engine/**/target/
bridge/**/target/
/execution-20261102/

# Local machine config
android/local.properties
android/keystore.properties

# Signing material (never commit)
android/keystore/
*.jks
*.keystore

# Generated web assets copied into the Android project
android/app/src/main/assets/public/

# Packaged artifacts
*.zip
*.apk
*.aab

# This is a required Android runtime asset, not a generated application package.
!ui/composeApp/src/androidMain/assets/x1ir.zip

# Local scratch scripts (one-off diagnostics, not part of build)
/_font-check.cjs

# Logs / OS cruft
*.log
.DS_Store

# Research evidence / agent handoffs (local, not part of the build)
/_research/

# local signing credentials (workspace sibling; defensive)
.secrets/
